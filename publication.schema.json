{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pH34r-pH/Portfolio/blob/main/publication.schema.json",
  "title": "Portfolio immutable publication manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtAt",
    "sources",
    "notebooks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "required": [
        "portfolio",
        "researchNotes",
        "theoremLibrary"
      ],
      "additionalProperties": false,
      "properties": {
        "portfolio": {
          "$ref": "#/$defs/source"
        },
        "researchNotes": {
          "$ref": "#/$defs/source"
        },
        "theoremLibrary": {
          "$ref": "#/$defs/source"
        },
        "fleet": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "notebooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "exampleKind": {
            "enum": [
              "illustrative"
            ]
          },
          "jupyterPath": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "path",
          "slug",
          "url",
          "title",
          "description",
          "date",
          "sha256",
          "renderedSha256",
          "assets",
          "browserExecution",
          "modelFocus",
          "dependsOn",
          "modelVariant"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^publication/articles/.+\\.md$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^/articles/[a-z0-9-]+/$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "renderedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "browserExecution": {
            "type": "boolean"
          },
          "modelFocus": {
            "enum": [
              "input",
              "tokenization",
              "representation",
              "recurrent-state",
              "normalization",
              "architecture",
              "consumer",
              "readout",
              "output",
              "full"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "frontier": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "ruledOut": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "open": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "next": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "modelVariant": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "required": [
              "fleet"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "not": {
              "required": [
                "fleet"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
