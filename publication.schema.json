{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pH34r-pH/Portfolio/blob/main/publication.schema.json",
  "title": "Portfolio immutable publication manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "builtAt",
    "sources",
    "notebooks"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "compilerProjection": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "sha256",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "pH34r-pH/experiment-compiler"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schemaVersion": {
          "const": 2
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "portfolio",
        "researchNotes",
        "theoremLibrary"
      ],
      "additionalProperties": false,
      "properties": {
        "portfolio": {
          "$ref": "#/$defs/source"
        },
        "researchNotes": {
          "$ref": "#/$defs/source"
        },
        "theoremLibrary": {
          "$ref": "#/$defs/source"
        },
        "fleet": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "notebooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "exampleKind": {
            "enum": [
              "illustrative"
            ]
          },
          "jupyterPath": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "path",
          "slug",
          "url",
          "title",
          "description",
          "date",
          "sha256",
          "renderedSha256",
          "assets",
          "browserExecution"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^publication/articles/.+\\.md$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^/articles/[a-z0-9-]+/$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "renderedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "browserExecution": {
            "type": "boolean"
          },
          "compiled_experiment": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://experiments.tyharbin.com/data/article-reference-v1.schema.json",
            "title": "Exact article reference v1 (public projection v2)",
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^(?!.*(?:^|-)latest(?:-|$))[a-z0-9][a-z0-9-]{0,79}$"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "profile": {
                    "enum": [
                      "compiled-experiment-v1",
                      "compiled-experiment-lifecycle-v1"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "required": [
                      "repository",
                      "commit"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "repository": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "shortTitle": {
            "type": "string",
            "minLength": 1
          },
          "modelFocus": {
            "type": "string",
            "minLength": 1
          },
          "modelVariant": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "frontierObserved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frontierOpen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frontierNext": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "required": [
              "fleet"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "not": {
              "required": [
                "fleet"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
