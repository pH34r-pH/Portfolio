{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Atlas Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "series"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "source",
          "metrics",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "empirical",
              "formal",
              "conceptual"
            ]
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "program",
              "evidence"
            ],
            "properties": {
              "program": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "value",
                "unit",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
